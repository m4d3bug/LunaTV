{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunatv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "routes": [
    {
      "pattern": "tv.madebug.net",
      "custom_domain": true
    }
  ]
}
